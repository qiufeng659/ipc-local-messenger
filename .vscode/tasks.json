{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure IPC Messenger (MinGW)",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build", "-G", "MinGW Makefiles", "-DCMAKE_BUILD_TYPE=Debug"],
      "problemMatcher": []
    },
    {
      "label": "Build IPC Messenger (MinGW)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--config", "Debug"],
      "dependsOn": "Configure IPC Messenger (MinGW)",
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    }
  ]
}
